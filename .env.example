# Modo desarrollo: usa mocks locales en lugar del backend real
VITE_USE_MOCKS=true

# API REST legacy (ya no requerida con Supabase)
VITE_API_URL=https://tu-api.example.com/api/v1

# Supabase — obtener en: https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
